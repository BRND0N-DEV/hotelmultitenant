# ==============================================================================
# SISTEMA DE GESTIÓN HOTELERA INTEGRAL MULTITENANT (PMS)
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# NOTA: Este archivo es una plantilla de ejemplo. No contiene secretos reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DEL ENTORNO DE ASP.NET CORE (.NET 9)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ------------------------------------------------------------------------------
# 2. CONEXIÓN A BASE DE DATOS (SQL SERVER 2025)
# ------------------------------------------------------------------------------
# Conexión local usando Windows Authentication / Integrated Security:
ConnectionStrings__DefaultConnection=Server=localhost;Database=HotelManagementDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Alternativa usando autenticación SQL Server (Usuario / Contraseña):
# ConnectionStrings__DefaultConnection=Server=localhost;Database=HotelManagementDb;User Id=sa;Password=YourSecurePassword123!;MultipleActiveResultSets=true;TrustServerCertificate=True

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y TOKEN JWT (AUTENTICACIÓN Y AUTORIZACIÓN)
# ------------------------------------------------------------------------------
# Clave simétrica de al menos 256 bits para firma de tokens (HMAC-SHA256)
Jwt__Secret=YourSuperSecretKeyWithAtLeast32CharactersRequiredForHmac256!
Jwt__Issuer=HotelManagementApi
Jwt__Audience=HotelManagementClients
Jwt__AccessTokenExpirationMinutes=20
Jwt__RefreshTokenExpirationDays=7

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE CORS (POLÍTICA DE ACCESO SEGURO ENTRE ORÍGENES)
# ------------------------------------------------------------------------------
# Orígenes permitidos separados por comas
Cors__AllowedOrigins=http://localhost:4200,http://127.0.0.1:4200

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL FRONTEND (ANGULAR)
# ------------------------------------------------------------------------------
# URL base de la API consumida por Angular
NG_APP_API_URL=http://localhost:5000/api
